# Copy to .env and adjust as needed. All values below are safe local defaults.

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Database (matches docker-compose.yml postgres service) ---
DATABASE_URL=postgresql+asyncpg://voiceops:voiceops@localhost:5432/voiceops

# --- LLM (Ollama, runs on host — see README for install/model pull steps) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30

# --- Speech-to-text (faster-whisper, runs in-process in the backend) ---
WHISPER_MODEL=base.en
WHISPER_DEVICE=auto

# --- Text-to-speech (Piper, runs on host — see README for voice model download) ---
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_PATH=./voice-models/piper

# --- Tools ---
TOOL_TIMEOUT_SECONDS=10

# --- Frontend ---
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
